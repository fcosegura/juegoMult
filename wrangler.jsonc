{
  "name": "tablasmult",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tablasmult-db",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ]
}
